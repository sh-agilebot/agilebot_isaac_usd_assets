      </geometry>
    </collision>
  </link>

  <!-- Camera pose frame on the camera mount -->
  <link name="camera_link"/>

  <!-- Joint: link6 -> camera_mount_link -->
  <joint name="camera_mount_joint" type="fixed">
    <parent link="link6"/>
    <child link="camera_mount_link"/>
    <origin xyz="0 0 0.012" rpy="1.57079632679 0 3.1415926535"/>
  </joint>

  <!-- Joint: camera mount -> camera pose frame -->
  <joint name="camera_link_joint" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0.01325 -0.06997" rpy="-1.2217304763960306 0 0"/>
  </joint>

